<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgConversacionAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_avatar"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_camera"
        android:contentDescription="Fotografía del contacto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvConversacionNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre del contacto"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#202020"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvConversacionHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="12:00"
                android:textSize="12sp"
                android:textColor="#777777"
                android:maxLines="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvConversacionUltimoMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toca para enviar un mensaje"
            android:textSize="13sp"
            android:textColor="#555555"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>