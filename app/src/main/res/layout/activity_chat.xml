<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:orientation="vertical">

    <!-- CABECERA DEL CHAT -->
    <LinearLayout
        android:id="@+id/barraSuperiorChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2457C5"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnVolverChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/ivAvatarContactoChat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_avatar"
            android:clipToOutline="true"
            android:contentDescription="Avatar del contacto"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreContactoChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Chat"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadoChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cargando mensajes..."
                android:textColor="#DCE8FF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- HISTORIAL DE MENSAJES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- BARRA INFERIOR PARA REDACTAR Y ENVIAR -->
    <LinearLayout
        android:id="@+id/barraInferiorChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#F4F6FA"
            android:hint="Escribe un mensaje..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#202020"
            android:textColorHint="#777777"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnEnviarMensaje"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="#2457C5"
            android:contentDescription="Enviar mensaje"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>